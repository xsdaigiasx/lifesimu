{
  "name": "mot-doi-de-song",
  "private": true,
  "version": "0.89.1",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/test.mjs",
    "sim:company": "node scripts/sim-company.cjs",
    "pool:check": "node scripts/pool-check.cjs",
    "talk:check": "node scripts/talk-check.cjs",
    "sim:npc": "node scripts/sim-npc.cjs",
    "sim:talk": "node scripts/sim-talk.cjs",
    "sim:life": "node scripts/sim-life.cjs",
    "art:verify": "python scripts/verify-upscaled-map.py",
    "deploy:workers": "npm run build && wrangler deploy --config wrangler.jsonc",
    "deploy:check": "wrangler deploy --config wrangler.jsonc --dry-run --outdir .wrangler/dry-run",
    "sim:town": "node scripts/sim-town.cjs",
    "sim:gossip": "node scripts/sim-gossip.cjs"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/node": "22.20.1",
    "@vitejs/plugin-react": "6.0.5",
    "typescript": "6.0.3",
    "vite": "8.2.1",
    "wrangler": "4.124.0"
  },
  "type": "module",
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
